---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import TechStack from "../components/TechStack.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Services from "../components/Services.astro";
import WhyUs from "../components/WhyUs.astro";
import WhyGitByte from "../components/WhyGitByte.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="GitByte — Backend Engineering Practice | PHP, Symfony, Laravel"
  description="Founder-led backend engineering practice specializing in PHP, Symfony, and Laravel. Authentication hardening, database optimization, legacy modernization, and production support."
>
  <Navbar />

  <Hero />

  <CaseStudies />

  <Services />

  <WhyUs />

  <TechStack />

  <WhyGitByte />

  <!-- About -->
  <section id="about" class="section-container section-padding relative py-28 sm:py-36 lg:py-44" data-reveal>
    <div class="mx-auto max-w-6xl">
      <div class="section-label">
        <span class="section-label-line" aria-hidden="true" />
        <span class="section-label-text">About</span>
      </div>

      <div class="max-w-3xl">
        <h2 class="heading-lg text-balance text-zinc-900 dark:text-zinc-100">
          Backend systems
          <br />
          <span class="gradient-text">practice.</span>
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-zinc-600 dark:text-zinc-200">
          GitByte is a founder-led backend engineering practice by Kirill Shevchenko. I work directly with SaaS founders, CTOs, and engineering teams on production systems. You work with the engineer who owns the architecture and implementation. Based in Podgorica, Montenegro, and working with SaaS companies remotely.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-zinc-600 dark:text-zinc-200">
          My focus is PHP backend systems built with Symfony, Laravel, and MySQL, plus the infrastructure needed to deploy and maintain them. I have helped companies with authentication hardening, database performance, legacy modernization, and production support.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-zinc-600 dark:text-zinc-200">
          <strong class="text-zinc-700 dark:text-zinc-200">Good fit:</strong> PHP backend systems, authentication/security, database optimization, legacy modernization, production support.
          <br />
          <strong class="text-zinc-700 dark:text-zinc-200">Not a fit:</strong> frontend-only projects, mobile apps, design work, non-PHP stacks.
        </p>
      </div>
    </div>
  </section>

  <CTA />
  <Footer />
</Layout>
