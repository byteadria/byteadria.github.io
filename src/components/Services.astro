---
export interface ServiceCard {
  icon: string;
  title: string;
  problem: string;
  value: string;
  technologies: string[];
}

export interface Props {
  sectionId?: string;
  heading?: string;
  subheading?: string;
  cards?: ServiceCard[];
}

const defaults: ServiceCard[] = [
  {
    icon: "server",
    title: "Backend Architecture",
    problem: "SaaS companies outgrow their initial backend setup. Monoliths become unwieldy and shipping new features requires structural changes that touch everything.",
    value: "Service boundaries, domain modelling, and versioned API contracts — so a change stays contained in the module that owns it.",
    technologies: ["Symfony", "Laravel", "PHP", "REST"],
  },
  {
    icon: "plug",
    title: "API Development & Integration",
    problem: "Products depend on external APIs, each with its own protocols, auth schemes, and failure modes.",
    value: "Integrations that fail gracefully instead of cascading across workflows — retry policies, circuit breakers, and contract validation before deployment.",
    technologies: ["REST", "OAuth", "PHP", "Symfony"],
  },
  {
    icon: "wrench",
    title: "Legacy Modernization",
    problem: "Large PHP codebases accumulate technical debt through security gaps, poor maintainability, and outdated patterns. Full rewrites are risky and expensive.",
    value: "Incremental refactoring that lowers technical debt and closes security gaps without a full rewrite or downtime.",
    technologies: ["PHP", "Symfony", "Legacy", "Security"],
  },
  {
    icon: "gauge",
    title: "Database Performance Engineering",
    problem: "Production databases slow down under growth. Queries that worked at small scale degrade into bottlenecks that users feel.",
    value: "Slow query analysis, index strategy redesign, and schema review — with latency measured before and after.",
    technologies: ["MySQL", "MariaDB", "SQLite", "SQL"],
  },
  {
    icon: "shield",
    title: "Security Hardening",
    problem: "Authentication systems accumulate security debt through weak session handling, missing cookie flags, and broken access control.",
    value: "Session hardening, consistent access control, and OWASP review — closing the specific gaps in your authentication flow.",
    technologies: ["Security", "Sessions", "Authentication", "PHP"],
  },
  {
    icon: "life-buoy",
    title: "Production Support",
    problem: "Fragile deployments, manual release steps, and monitoring gaps leave production issues to be discovered by users.",
    value: "Structured troubleshooting, deployment automation, and monitoring that surface problems early.",
    technologies: ["Docker", "Linux", "Nginx", "WordPress"],
  },
];

const { sectionId = "services", heading = "Services", subheading = "Security gaps, slow queries, and tangled architecture.", cards = defaults } = Astro.props;
---

<section
  id={sectionId}
  class="section-container section-padding relative py-28 sm:py-36 lg:py-44"
  data-reveal
>
  <div class="mx-auto max-w-6xl">
    <div class="section-label">
      <span class="section-label-line" aria-hidden="true" />
      <span class="section-label-text">
        {heading}
      </span>
    </div>

    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="heading-lg text-balance text-zinc-900 dark:text-zinc-100">
        Making backend systems
        <br />
        <span class="gradient-text">easier to change.</span>
      </h2>
      <p class="max-w-md text-base leading-relaxed text-zinc-500 dark:text-zinc-200 sm:text-right">
        {subheading}
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        cards.map((card, i) => (
          <article
            class="group relative cursor-pointer rounded-2xl border border-zinc-200/60 bg-white p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-zinc-300/80 hover:bg-zinc-50 hover:shadow-[0_0_32px_rgba(37,99,235,0.04)] active:brightness-95 dark:border-zinc-800/40 dark:bg-zinc-900/30 dark:hover:border-zinc-700/50 dark:hover:bg-zinc-900/60 dark:hover:shadow-[0_0_32px_rgba(96,165,250,0.04)] dark:active:brightness-90"
            data-reveal
            data-si={i}
            data-tilt
          >
            <div
              class="mb-4 flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600/10 transition-colors duration-300 group-hover:bg-blue-600/15 dark:bg-blue-400/10 dark:group-hover:bg-blue-400/15"
            >
              {
                card.icon === "server" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 17.25v-.228a4.5 4.5 0 0 0-.12-1.03l-2.268-9.64a3.375 3.375 0 0 0-3.285-2.602H7.923a3.375 3.375 0 0 0-3.285 2.602l-2.268 9.64a4.5 4.5 0 0 0-.12 1.03v.228m19.5 0a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3m19.5 0a3 3 0 0 0-3-3H5.25a3 3 0 0 0-3 3m16.5 0h.008v.008h-.008v-.008Zm-3 0h.008v.008h-.008v-.008Z" />
                  </svg>
                )
              }
              {
                card.icon === "shield" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                  </svg>
                )
              }
              {
                card.icon === "plug" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z" />
                  </svg>
                )
              }
              {
                card.icon === "gauge" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                  </svg>
                )
              }
              {
                card.icon === "wrench" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
                  </svg>
                )
              }
              {
                card.icon === "life-buoy" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                  </svg>
                )
              }
            </div>

            <h3 class="heading text-zinc-900 dark:text-zinc-100">
              {card.title}
            </h3>

            <p class="mt-2 text-base leading-relaxed text-zinc-600 dark:text-zinc-200">
              {card.problem}
            </p>

            <p class="mt-3 text-base leading-relaxed text-zinc-500 dark:text-zinc-300">
              {card.value}
            </p>

            <ul class="mt-4 flex flex-wrap gap-x-2.5 gap-y-1">
              {
                card.technologies.map((tag) => (
                  <li class="text-base font-medium tracking-wide text-zinc-500 transition-colors duration-200 group-hover:text-zinc-700 dark:text-zinc-200 dark:group-hover:text-zinc-100">
                    {tag}
                  </li>
                ))
              }
            </ul>
            <span class="mt-3 inline-flex items-center gap-1 text-base text-zinc-500 transition-all duration-200 group-hover:text-zinc-700 dark:text-zinc-200 dark:group-hover:text-zinc-100">
              Click for details <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Service modal -->
<div
  id="service-modal"
  class="fixed inset-0 z-[100] flex items-end sm:items-center justify-center p-0 sm:p-4 opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-label="Service details"
  aria-labelledby="service-modal-title"
>
  <div class="absolute inset-0 bg-white/80 backdrop-blur-sm dark:bg-zinc-950/80" data-service-close></div>
  <div class="relative w-full max-w-2xl max-h-screen sm:max-h-[85vh] overflow-y-auto rounded-t-2xl sm:rounded-2xl border-0 sm:border sm:border-zinc-200 bg-white shadow-2xl shadow-black/10 scrollbar-thin dark:border-zinc-800 dark:bg-zinc-900 dark:shadow-black/50">
    <button
        class="sticky top-0 z-10 flex w-full items-center justify-between border-b border-zinc-200/80 bg-white/95 px-4 py-3 sm:absolute sm:right-3 sm:top-3 sm:w-auto sm:rounded-xl sm:border sm:border-zinc-200 sm:bg-white/70 sm:px-3 sm:py-2.5 sm:text-base sm:font-semibold sm:text-zinc-700 sm:backdrop-blur-sm sm:transition-colors sm:hover:bg-zinc-50/80 sm:hover:text-zinc-900 dark:border-zinc-700/50 dark:bg-zinc-800/95 dark:sm:border-zinc-700 dark:sm:bg-zinc-700/70 dark:sm:text-zinc-100 dark:sm:hover:bg-zinc-600/80 dark:sm:hover:text-zinc-100"
      data-service-close
      aria-label="Close"
    >
      <span class="text-base font-semibold">Close</span>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="p-6 sm:p-10" id="service-modal-body"></div>
  </div>
</div>

<script>
  (() => {
    const modal = document.getElementById("service-modal");
    const body = document.getElementById("service-modal-body");
    const triggers = document.querySelectorAll("[data-si]");
    const closes = modal.querySelectorAll("[data-service-close]");

    const services = [
      {
        title: "Backend Architecture",
        when: [
          "Monolith is becoming difficult to change without breaking unrelated features",
          "Service boundaries don't reflect actual domain responsibilities",
          "Scaling deployments requires coordinated changes across multiple modules",
          "New engineers struggle to understand where logic belongs",
        ],
        approach: [
          "Domain-driven boundary analysis to identify cohesive units of responsibility",
          "Event and dependency mapping between existing modules",
          "Interface contract design with versioned APIs and backward compatibility",
          "Queue-based decoupling for operations that shouldn't block the request cycle",
          "Deployment pipeline design with environment parity and rollback capability",
        ],
        outcomes: [
          "Clear module boundaries that reduce cognitive load",
          "Independent deployment capability for individual services",
          "API contracts that evolve without breaking consumers",
          "Codebase structure that scales with team size",
        ],
        examples: [
          "Extracted order processing from a monolithic Symfony application into a bounded service with its own data access layer and queue workers",
          "Designed RESTful API versioning strategy for a SaaS platform supporting multiple client versions simultaneously",
          "Introduced async processing for long-running report generation, reducing P95 response times from 12s to 400ms",
        ],
        technologies: ["Symfony", "Laravel", "PHP", "REST"],
      },
      {
        title: "API Development & Integration",
        when: [
          "Third-party provider APIs have different authentication schemes and failure modes",
          "Partial failures in external integrations cascade into unrelated workflows",
          "Webhook handling lacks signature verification and retry logic",
          "Integration tests don't validate actual contract compliance",
        ],
        approach: [
          "Provider-specific adapter classes with consistent error handling",
          "Authentication strategy selection covering OAuth 2.0 flows, API keys, and token refresh",
          "Retry policies with exponential backoff and circuit breaker patterns",
          "Webhook verification with HMAC signatures and idempotent processing",
          "Contract test suites validating request/response schemas before deployment",
        ],
        outcomes: [
          "External integrations that fail gracefully without cascading",
          "Consistent authentication handling across all providers",
          "Webhook processing that's idempotent and auditable",
          "Test coverage that catches contract drift before production",
        ],
        examples: [
          "Built adapter layer for a payment provider integration with automatic failover between primary and backup APIs",
          "Implemented OAuth 2.0 authorization code flow with token refresh for a SaaS platform connecting to multiple external services",
          "Designed webhook dispatch system with HMAC verification, retry logic, and dead-letter queue for failed deliveries",
        ],
        technologies: ["REST", "OAuth", "PHP", "Symfony"],
      },
      {
        title: "Legacy Modernization",
        when: [
          "Security audit reveals session handling and access control gaps",
          "Codebase has grown organically with inconsistent patterns and poor separation of concerns",
          "Critical business logic is embedded in presentation layers",
          "Next engineer hired will struggle to onboard without significant guidance",
        ],
        approach: [
          "Incremental refactoring with working software at every step",
          "Security improvements deployed independently, including session hardening, cookie flags, and CSRF",
          "Dependency injection and service container adoption for testability",
          "Code structure improvements through extraction of domain services",
          "Documentation of architectural decisions for team continuity",
        ],
        outcomes: [
          "Security measurably improved without breaking integrations",
          "Codebase that's approachable for the next engineer",
          "Test coverage that enables confident future changes",
          "Domain logic moved out of controllers into dedicated services",
        ],
        examples: [
          "Refactored a 200K-line Symfony monolith by extracting domain services, introducing dependency injection, and achieving 70% test coverage incrementally over 6 months",
          "Hardened session management across 40+ legacy controllers using secure flags, fixation prevention, and consistent access control via voters",
          "Migrated embedded SQL from controller methods to repository layer with query builder, improving testability and maintainability",
        ],
        technologies: ["PHP", "Symfony", "Legacy", "Security"],
      },
      {
        title: "Database Performance Engineering",
        when: [
          "API response times increase as data volume grows",
          "Slow query logs show queries running in seconds instead of milliseconds",
          "Database costs grow without clear correlation to traffic increases",
          "Write performance degrades after adding indexes for read-heavy queries",
        ],
        approach: [
          "EXPLAIN plan analysis for top slowest queries by frequency and duration",
          "Index strategy redesign using composite and covering indexes, plus redundant index cleanup",
          "N+1 query detection and consolidation using batch loading",
          "Subquery-to-JOIN rewrites where the optimizer can leverage indexes better",
          "Schema review for data type alignment and write amplification reduction",
        ],
        outcomes: [
          "Measurable reduction in P95 and P99 query latency",
          "Write performance preserved or improved through index optimization",
          "Database resource utilization aligned with actual traffic patterns",
          "Query patterns that scale predictably with data growth",
        ],
        examples: [
          "Reduced P95 query latency from 2.4s to 180ms by redesigning composite indexes and eliminating N+1 patterns in a Symfony repository layer",
          "Identified and removed 12 redundant indexes that were causing write amplification without improving read performance",
          "Rewrote 15 slow queries using JOIN optimization and covering indexes, reducing average query time by 73%",
        ],
        technologies: ["MySQL", "MariaDB", "SQLite", "SQL"],
      },
      {
        title: "Security Hardening",
        when: [
          "Security audit reveals session handling gaps including missing cookie flags and no fingerprint validation",
          "Access control is implemented inconsistently across controllers",
          "CSRF protection is missing from state-changing API endpoints",
          "Third-party penetration test identified authentication weaknesses",
        ],
        approach: [
          "Session transport hardening with secure, HttpOnly, and SameSite cookie flags",
          "Session binding to client characteristics to detect hijacking",
          "Access control standardization using Symfony voters replacing inline role checks",
          "CSRF audit across forms and API endpoints with consistent token validation",
          "OWASP-focused review of authentication flows and dependency vulnerabilities",
        ],
        outcomes: [
          "Session hijacking and fixation attacks prevented at transport layer",
          "Consistent access control model across all application endpoints",
          "CSRF protection validated across every state-changing operation",
          "Security controls that pass external audit review",
        ],
        examples: [
          "Hardened session management across 40+ legacy controllers using secure flags, fixation prevention, and idle timeout enforcement",
          "Implemented browser fingerprint binding that detected 3 hijacked sessions in the first month without impacting legitimate users",
          "Standardized CSRF protection across 120+ forms and API endpoints using Symfony's CSRF component with token rotation",
        ],
        technologies: ["Security", "Sessions", "Authentication", "PHP"],
      },
      {
        title: "Production Support",
        when: [
          "Production incidents require senior-level troubleshooting and root cause analysis",
          "Deployment pipeline is fragile with manual steps and no rollback capability",
          "Server configuration drift between development and production environments",
          "Monitoring gaps mean users discover issues before the system does",
        ],
        approach: [
          "Incident triage with systematic root cause analysis and documentation",
          "Docker containerization with consistent environments from development to production",
          "Nginx configuration review and optimization for serving PHP applications",
          "Deployment pipeline automation with health checks and rollback triggers",
          "Monitoring and alerting setup for proactive issue detection",
        ],
        outcomes: [
          "Faster incident resolution with documented root causes",
          "Consistent environments that eliminate 'works on my machine' issues",
          "Deployment confidence through automation and rollback capability",
          "Proactive monitoring that catches issues before users do",
        ],
        examples: [
          "Containerized a legacy PHP application with Docker, achieving environment parity and reducing deployment time from 45 minutes to 3 minutes",
          "Configured Nginx with PHP-FPM tuning for a high-traffic Symfony application, reducing response times by 30% under load",
          "Set up health check monitoring that detected database connection pool exhaustion before it caused user-facing errors",
        ],
        technologies: ["Docker", "Linux", "Nginx", "WordPress"],
      },
    ];

    function open(index) {
      const s = services[index];

      const listItem = (text) => '<li class="text-base leading-relaxed text-zinc-600 pl-4 relative before:content-[\'–\'] before:absolute before:left-0 before:text-blue-600 dark:text-zinc-200 dark:before:text-blue-400">' + text + "</li>";

      const whenItems = s.when.map(listItem).join("");
      const approachItems = s.approach.map(listItem).join("");
      const outcomesItems = s.outcomes.map(listItem).join("");
      const examplesItems = s.examples.map(listItem).join("");

      const techTags = s.technologies
        .map((t) => '<span class="rounded-md border border-zinc-300/60 bg-zinc-100/80 px-2 py-0.5 text-base font-medium text-zinc-600 dark:border-zinc-700/60 dark:bg-zinc-800/80 dark:text-zinc-100">' + t + "</span>")
        .join("");

      body.innerHTML =
        '<h3 class="heading text-zinc-900 dark:text-zinc-100" id="service-modal-title">' + s.title + "</h3>" +

        '<div class="mt-8">' +
        '<h4 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">Common situations I help with</h4>' +
        '<ul class="mt-3 space-y-2">' + whenItems + "</ul>" +
        "</div>" +

        '<div class="mt-8">' +
        '<h4 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">How I approach it</h4>' +
        '<ul class="mt-3 space-y-2">' + approachItems + "</ul>" +
        "</div>" +

        '<div class="mt-8">' +
        '<h4 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">Typical outcomes</h4>' +
        '<ul class="mt-3 space-y-2">' + outcomesItems + "</ul>" +
        "</div>" +

        '<div class="mt-8">' +
        '<h4 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">Example challenges</h4>' +
        '<ul class="mt-3 space-y-2">' + examplesItems + "</ul>" +
        "</div>" +

        '<div class="mt-8 flex flex-wrap gap-2">' + techTags + "</div>";

      modal.classList.remove("opacity-0", "pointer-events-none");
      document.body.style.overflow = "hidden";
    }

    function close() {
      modal.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = "";
    }

    triggers.forEach((el) => {
      el.addEventListener("click", () => open(parseInt(el.dataset.si)));
    });
    closes.forEach((el) => el.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  })();
</script>
