---
export interface Props {
  sectionId?: string;
  email?: string;
  web3formsKey?: string;
}

const {
  sectionId = "contact",
  email = "hello.gitbyte@gmail.com",
  web3formsKey = "03e1d391-8c07-4f26-a31c-d0ac631fe7ad",
} = Astro.props;
---

<section
  id={sectionId}
  class="section-container section-padding relative py-28 sm:py-36 lg:py-44 bg-zinc-100 dark:bg-zinc-900/40"
  data-reveal
>
  <div class="mx-auto max-w-6xl">
    <!-- Section label -->
    <div class="section-label">
      <span class="section-label-line" aria-hidden="true" />
      <span class="section-label-text">Contact</span>
    </div>

    <div class="grid gap-16 lg:grid-cols-5">
      <!-- Left: headline + text -->
      <div class="lg:col-span-2">
        <h2 class="heading-lg text-balance text-zinc-900 dark:text-zinc-100">
          Let's
          <br />
          <span class="gradient-text">talk.</span>
        </h2>
        <p class="mt-4 max-w-md text-lg leading-relaxed text-zinc-700 dark:text-zinc-100">
          Tell me about the challenges in your backend — authentication, databases, APIs, or legacy code. If it's within my stack, I'll assess your system and outline what needs to change before any work begins.
        </p>
        <div class="mt-8 max-w-md">
          <h3 class="heading-sm text-zinc-900 dark:text-zinc-100">
            How engagements work
          </h3>
          <ul class="mt-3 space-y-2 text-base leading-relaxed text-zinc-600 dark:text-zinc-200">
            <li>NDA available on request — signed before any discussion.</li>
            <li>Confidentiality is standard on every engagement.</li>
            <li>Access is scoped to the engagement — nothing beyond it.</li>
            <li>Credentials remain under your control.</li>
            <li>Deployments include a rollback plan before anything ships.</li>
          </ul>
        </div>
      </div>

      <!-- Right: contact form -->
      <div class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm sm:p-8 lg:col-span-3 dark:border-zinc-700/50 dark:bg-zinc-800/50 dark:shadow-black/10">
        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="GitByte — Backend engineering inquiry" />
          <input type="hidden" name="redirect" value="" />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
          <p class="heading text-zinc-900 dark:text-zinc-100">
            I analyze your system before I change anything.
          </p>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-base font-medium text-zinc-700 dark:text-zinc-200">
                Name
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder="Your name"
                class="w-full rounded-xl border border-zinc-300/80 bg-white px-4 py-2.5 text-base text-zinc-900 placeholder-zinc-400 transition-colors duration-200 focus:border-blue-500/50 focus:bg-white focus:outline-none dark:border-zinc-800/60 dark:bg-zinc-900/50 dark:text-zinc-200 dark:placeholder-zinc-500 dark:focus:border-blue-400/40 dark:focus:bg-zinc-900/80"
              />
            </div>
            <div>
              <label for="email-input" class="mb-1.5 block text-base font-medium text-zinc-700 dark:text-zinc-200">
                Email
              </label>
              <input
                id="email-input"
                name="email"
                type="email"
                required
                placeholder="you@company.com"
                class="w-full rounded-xl border border-zinc-300/80 bg-white px-4 py-2.5 text-base text-zinc-900 placeholder-zinc-400 transition-colors duration-200 focus:border-blue-500/50 focus:bg-white focus:outline-none dark:border-zinc-800/60 dark:bg-zinc-900/50 dark:text-zinc-200 dark:placeholder-zinc-500 dark:focus:border-blue-400/40 dark:focus:bg-zinc-900/80"
              />
            </div>
          </div>
          <div>
            <label for="message" class="mb-1.5 block text-base font-medium text-zinc-700 dark:text-zinc-200">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows={4}
              required
              placeholder="Describe the backend challenge: stack, constraints, and what you need."
              class="w-full resize-none rounded-xl border border-zinc-300/80 bg-white px-4 py-2.5 text-base text-zinc-900 placeholder-zinc-400 transition-colors duration-200 focus:border-blue-500/50 focus:bg-white focus:outline-none dark:border-zinc-800/60 dark:bg-zinc-900/50 dark:text-zinc-200 dark:placeholder-zinc-500 dark:focus:border-blue-400/40 dark:focus:bg-zinc-900/80"
            ></textarea>
          </div>
          <div id="form-status" class="hidden text-base"></div>
          <div class="flex items-center justify-between gap-4">
            <p class="text-base text-zinc-500 dark:text-zinc-200">
              Prefer email?
              <a href={`mailto:${email}`} class="text-blue-600 underline-offset-2 hover:underline dark:text-blue-400">
                {email}
              </a>
            </p>
            <button
              id="form-submit"
              type="submit"
              class="inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 text-base font-semibold text-white transition-colors duration-200 hover:bg-blue-500 active:scale-[0.97] dark:bg-blue-400 dark:text-zinc-950 dark:hover:bg-blue-300"
            >
              <span id="form-submit-text">Send message</span>
              <span id="form-spinner" class="hidden">
                <svg class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                </svg>
              </span>
              <svg id="form-send-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
              </svg>
            </button>
          </div>
          <p class="mt-4 text-base text-zinc-500 dark:text-zinc-300">
            I reply within 48 hours.
          </p>
          <p class="mt-1 text-base text-zinc-500 dark:text-zinc-300">
            Your name and email are used only to reply to this message. The form is processed by Web3Forms; your information is not shared.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const form = document.getElementById("contact-form");
    if (!form) return;

    const status = document.getElementById("form-status");
    const submitBtn = document.getElementById("form-submit");
    const submitText = document.getElementById("form-submit-text");
    const spinner = document.getElementById("form-spinner");
    const sendIcon = document.getElementById("form-send-icon");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      status.classList.add("hidden");
      status.className = "text-base";
      submitBtn.disabled = true;
      submitText.textContent = "Sending...";
      spinner.classList.remove("hidden");
      sendIcon.classList.add("hidden");

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });

        const data = await res.json();

        if (data.success) {
          status.textContent = "Message sent. I'll get back within 48 hours.";
          status.className = "text-base text-green-600 dark:text-green-300";
          form.reset();
        } else {
          status.textContent = data.message || "Something went wrong. Please try again.";
          status.className = "text-base text-red-600 dark:text-red-300";
        }
      } catch {
        status.textContent = "Network error. Please try again or email me directly.";
        status.className = "text-base text-red-300";
      }

      status.classList.remove("hidden");
      submitBtn.disabled = false;
      submitText.textContent = "Send message";
      spinner.classList.add("hidden");
      sendIcon.classList.remove("hidden");
    });
  })();
</script>
