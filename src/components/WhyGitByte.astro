---
export interface WhyItem {
  icon: string;
  title: string;
  description: string;
}

const items: WhyItem[] = [
  {
    icon: "user",
    title: "Direct access to senior engineer",
    description:
      "You work with the founder, the same engineer who architects your system, writes the code, and deploys to production. No handoffs, no account managers, no layers.",
  },
  {
    icon: "ban",
    title: "No outsourcing",
    description:
      "Every line of code, every architecture decision, every deployment is handled directly. No subcontracting, no offshore teams, no mystery about who's building your system.",
  },
  {
    icon: "clock",
    title: "Production experience",
    description:
      "Seven years of backend systems running in production. Systems designed for reliability, not demos.",
  },
  {
    icon: "compass",
    title: "Architecture before implementation",
    description:
      "API contracts, data models, and service boundaries defined before code is written. Architecture decisions made deliberately, not accidentally.",
  },
  {
    icon: "shield",
    title: "Security and maintainability focused",
    description:
      "Security integrated from design, not bolted on after. Codebases built to be readable, documented, and easy for the next engineer to take over.",
  },
  {
    icon: "anchor",
    title: "Long-term ownership mindset",
    description:
      "Systems built to last, not to generate repeat tickets. Sustainable codebases, migration paths, and documentation that outlasts the engagement.",
  },
];
---

<section
  id="why-gitbyte"
  class="section-container section-padding relative py-28 sm:py-36 lg:py-44"
  data-reveal
>
  <div class="mx-auto max-w-6xl">
    <div class="section-label">
      <span class="section-label-line" aria-hidden="true" />
      <span class="section-label-text">
        Why GitByte
      </span>
    </div>

    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="heading-lg text-balance text-zinc-900 dark:text-zinc-100">
        Founder-led
        <br />
        <span class="gradient-text">engineering.</span>
      </h2>
      <p class="max-w-md text-base leading-relaxed text-zinc-500 dark:text-zinc-200 sm:text-right">
        One engineer, full accountability. No agency overhead or outsourcing.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        items.map((item) => (
          <div
            class="flex flex-col gap-3 rounded-xl border border-zinc-200/50 bg-zinc-50/60 p-6 transition-all duration-300 hover:scale-[1.02] hover:border-zinc-300/60 hover:bg-zinc-100/60 hover:shadow-[0_0_24px_rgba(37,99,235,0.03)] active:brightness-95 sm:p-7 lg:p-8 dark:border-zinc-800/30 dark:bg-zinc-900/40 dark:hover:border-zinc-700/50 dark:hover:bg-zinc-900/70 dark:hover:shadow-[0_0_24px_rgba(96,165,250,0.03)] dark:active:brightness-90"
            data-reveal
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-600/10 dark:bg-blue-400/10"
              >
                {item.icon === "user" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                  </svg>
                )}
                {item.icon === "ban" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
                  </svg>
                )}
                {item.icon === "clock" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                  </svg>
                )}
                {item.icon === "compass" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                  </svg>
                )}
                {item.icon === "shield" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                  </svg>
                )}
                {item.icon === "anchor" && (
                  <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.462.725-3.545" />
                  </svg>
                )}
              </div>
              <h3 class="heading-sm text-zinc-900 dark:text-zinc-100">{item.title}</h3>
            </div>
            <p class="text-lg leading-relaxed text-zinc-600 dark:text-zinc-200">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
