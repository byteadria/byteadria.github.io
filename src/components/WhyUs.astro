---
export interface WhyItem {
  icon: string;
  title: string;
  description: string;
}

export interface Props {
  sectionId?: string;
  heading?: string;
  items?: WhyItem[];
}

const defaults: WhyItem[] = [
  {
    icon: "users",
    title: "Direct engagement",
    description:
      "A senior engineer personally owns the work, end to end.",
  },
  {
    icon: "lightbulb",
    title: "Contract-first architecture",
    description:
      "API contracts, data models, and integration boundaries defined before implementation begins.",
  },
  {
    icon: "target",
    title: "Production experience",
    description:
      "Work is validated against production-like load and real failure modes before it ships.",
  },
  {
    icon: "shield",
    title: "Engineering discipline",
    description:
      "Code review, test coverage, and deployment validation that keeps systems working.",
  },
  {
    icon: "zap",
    title: "Async-friendly operations",
    description:
      "Overlap with US Eastern and Central European time zones. Structured, async-first communication with documented updates.",
  },
  {
    icon: "file-text",
    title: "Maintainable codebases",
    description:
      "Readable code, documented trade-offs, and migration paths that another engineer can continue working with.",
  },
];

const { sectionId = "why-us", heading = "Approach", items = defaults } = Astro.props;
---

<section
  id={sectionId}
  class="section-container section-padding relative py-28 sm:py-36 lg:py-44"
  data-reveal
>
  <div class="mx-auto max-w-6xl">
    <div class="section-label">
      <span class="section-label-line" aria-hidden="true" />
      <span class="section-label-text">
        {heading}
      </span>
    </div>

    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="heading-lg text-balance text-zinc-900 dark:text-zinc-100">
        How I
        <br />
        <span class="gradient-text">work.</span>
      </h2>
      <p class="max-w-md text-base leading-relaxed text-zinc-500 dark:text-zinc-200 sm:text-right">
        Clear contracts and direct communication throughout the project.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        items.map((item) => (
          <div
            class="flex flex-col gap-3 rounded-xl border border-zinc-200/50 bg-zinc-50/60 p-6 transition-all duration-300 hover:scale-[1.02] hover:border-zinc-300/60 hover:bg-zinc-100/60 hover:shadow-[0_0_24px_rgba(37,99,235,0.03)] active:brightness-95 sm:p-7 lg:p-8 dark:border-zinc-800/30 dark:bg-zinc-900/40 dark:hover:border-zinc-700/50 dark:hover:bg-zinc-900/70 dark:hover:shadow-[0_0_24px_rgba(96,165,250,0.03)] dark:active:brightness-90"
            data-reveal
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-600/10 dark:bg-blue-400/10"
              >
                {
                  item.icon === "users" && (
                    <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                    </svg>
                  )
                }
                {
                  item.icon === "lightbulb" && (
                    <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />
                    </svg>
                  )
                }
                {
                  item.icon === "target" && (
                    <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                    </svg>
                  )
                }
                {
                  item.icon === "shield" && (
                    <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                    </svg>
                  )
                }
                {
                  item.icon === "zap" && (
                    <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
                    </svg>
                  )
                }
                {
                  item.icon === "file-text" && (
                    <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>
                  )
                }
              </div>
              <h3 class="heading-sm text-zinc-900 dark:text-zinc-100">{item.title}</h3>
            </div>
            <p class="text-lg leading-relaxed text-zinc-600 dark:text-zinc-200">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
