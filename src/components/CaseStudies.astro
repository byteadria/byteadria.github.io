---
export interface CaseStudy {
  id: string;
  number: string;
  title: string;
  type: string;
  challenge: string;
  work: string;
  decisions: string;
  stack: string[];
  result: string;
  link?: { label: string; url: string };
}

export interface Props {
  sectionId?: string;
  heading?: string;
  subheading?: string;
  studies?: CaseStudy[];
}

const defaults: CaseStudy[] = [
  {
    id: "auth",
    number: "01",
    title: "Authentication Security Hardening",
    type: "Production backend security hardening",
    challenge: "A production Symfony backend had accumulated security debt over several years. Session handling followed outdated patterns — no secure cookie flags, no fingerprint validation, and inconsistent access control across legacy controllers. The system was functional but exposed to session hijacking, fixation attacks, and unauthorized access through poorly protected endpoints. Active integrations depended on existing session behavior, so the authentication layer couldn't be replaced wholesale.",
    work: "Audited the entire authentication pipeline across 40+ legacy controllers. Implemented secure cookie flags (HttpOnly, Secure, SameSite) and session fixation prevention. Introduced browser fingerprint binding to detect hijacked sessions without impacting legitimate users. Replaced inline role checks with Symfony voters for consistent access control. Standardized CSRF protection across all state-changing endpoints.",
    decisions: "Layered security approach — each layer deployed independently to minimize blast radius. Session hardening at transport layer, fingerprint validation at application layer, access control improvements at controller layer. Chose incremental deployment over wholesale replacement to preserve existing integrations.",
    stack: ["PHP", "Symfony", "Security", "Sessions"],
    result: "Authentication layer hardened across transport, session, and access control layers. Legacy controllers brought under consistent security model. Zero downtime deployment with no breaking changes to existing integrations.",
  },
  {
    id: "db",
    number: "02",
    title: "Database Performance Engineering",
    type: "Production database optimization",
    challenge: "A MySQL database serving a production backend was experiencing degraded performance under load. Slow query logs showed multiple queries running in seconds instead of milliseconds. The database had grown organically over several years — indexes were inconsistent, queries used inefficient patterns, and the schema had accumulated redundant columns from past features. Index changes on a high-write database risked write amplification.",
    work: "Analyzed slow query logs and EXPLAIN plans for the top 10 slowest queries by frequency and duration. Redesigned index strategy — composite indexes for common patterns, covering indexes to eliminate table lookups, redundant index cleanup. Detected and consolidated N+1 query patterns. Rewrote subqueries as JOINs where the optimizer could use indexes more effectively. Reviewed schema for data type alignment.",
    decisions: "Measured approach: analyze first, optimize incrementally, validate under production-like load. Each optimization treated as a discrete change with its own validation — no batch rewrites. Prioritized by impact: top 10 slowest queries first. Preserved write performance by removing redundant indexes before adding new ones.",
    stack: ["MySQL", "MariaDB", "SQL", "PHP"],
    result: "Highest-impact query bottlenecks resolved through targeted optimization. Write performance preserved by removing redundant indexes. Schema cleanup reduced storage overhead and improved buffer pool efficiency. All changes deployed against production-representative load before live application.",
    link: { label: "Technical details available on request", url: "#" },
  },
  {
    id: "api",
    number: "03",
    title: "Enterprise API Integration Platform",
    type: "External system integration architecture",
    challenge: "An enterprise backend needed to connect internal systems with external platforms — payment providers, partner APIs, and legacy SOAP services. Each external system had different protocols, authentication mechanisms, error formats, and availability profiles. Integration logic was scattered across controllers with no consistent error handling or retry strategy. Partial failures in one integration were cascading into unrelated workflows.",
    work: "Designed a unified integration layer that abstracts protocol differences behind a consistent interface. Built dedicated adapter classes for each external system — REST clients with OAuth/token management, SOAP clients with WSDL-based request construction, webhook handlers with HMAC signature verification. Implemented shared retry and circuit breaker layer below the adapters. Normalized error responses into consistent internal format.",
    decisions: "Adapter pattern chosen to isolate protocol-specific logic. Shared resilience layer provides consistent retry, circuit breaker, and rate limiting behavior across all integrations. Error normalization enables consistent monitoring and alerting. Contract test suites validate each adapter against mocked external responses before deployment.",
    stack: ["PHP", "Symfony", "REST", "SOAP", "OAuth"],
    result: "External integrations consolidated behind consistent interface. Adding new systems requires implementing only an adapter — connection, retry, and error handling inherited from shared layer. Partial failures no longer cascade into unrelated workflows.",
    link: { label: "Technical details available on request", url: "#" },
  },
  {
    id: "fintech",
    number: "04",
    title: "Secure Financial Transaction Backend",
    type: "Payment processing system architecture",
    challenge: "A financial technology platform needed a backend architecture for transaction workflows — handling payment processing, cryptographic operations on sensitive data, and integration with multiple financial service providers. The existing system processed transactions synchronously, creating bottlenecks during peak loads and no graceful failure handling when a provider was unavailable. Financial regulations required complete audit trails for every transaction state change.",
    work: "Designed an event-driven transaction workflow engine with provider-agnostic payment processing. Implemented transaction state machine with enforced transitions — each state change validated preconditions and recorded immutable audit entry. Built provider abstraction layer with automatic failover. Decoupled payment processing from request cycle using queue workers with idempotent processing. Isolated cryptographic operations in dedicated service classes.",
    decisions: "Event-driven architecture chosen for async processing and provider failover. Immutable audit entries at each transition for compliance. Idempotent processing prevents duplicate charges on retries. Provider abstraction enables adding new payment services without touching transaction logic. Cryptographic isolation simplifies security auditing and key rotation.",
    stack: ["PHP", "APIs", "Security", "Queues"],
    result: "Transactions processed asynchronously with idempotent handling — no duplicate charges, no lost transactions. Each state transition immutably logged for compliance. Provider failover occurs automatically without interrupting in-flight transactions. Cryptographic operations isolated from business logic.",
    link: { label: "Technical details available on request", url: "#" },
  },
  {
    id: "platform",
    number: "05",
    title: "Production Platform Infrastructure",
    type: "Production system maintenance and extension",
    challenge: "A production educational platform (BetsuNippon) needed ongoing maintenance and extension — custom WordPress plugins, SQLite data layer, server administration, event management workflows, and content infrastructure for active users. The existing WordPress installation had custom requirements that couldn't be met with off-the-shelf plugins. Server administration and deployment processes required standardization.",
    work: "Maintained and extended the existing WordPress-based infrastructure. Built custom PHP plugins for event management and content workflows. Managed server administration, SQLite data layer, and improved reliability. Implemented deployment standardization and monitoring. Extended content management capabilities while preserving system stability.",
    decisions: "Extended existing WordPress infrastructure rather than rewriting — platform was functional and had active users. Custom plugins for requirements that couldn't be met with off-the-shelf solutions. SQLite chosen for lightweight data layer where MySQL overhead wasn't justified. Standardized deployment processes for maintainability.",
    stack: ["WordPress", "PHP", "SQLite", "Linux"],
    result: "Production system supporting active users. Maintained and extended existing infrastructure, improved reliability without full rewrite. Custom plugins provided event management capabilities aligned with specific operational requirements.",
    link: { label: "Visit BetsuNippon", url: "https://www.betsunippon.us.to/" },
  },
  {
    id: "order-api",
    number: "06",
    title: "REST API Order Management",
    type: "Backend API system with external integrations",
    challenge: "Needed a Symfony-based backend system for order processing with external API integration, full-text search, and containerized deployment. Required integration with external tile pricing API, SOAP order import, MySQL persistence, and Manticore Search for full-text queries.",
    work: "Built Symfony 7.2 backend with Docker Compose containerization. Implemented REST API endpoints for order CRUD, statistics aggregation with pagination, and full-text search via Manticore. Integrated external tile pricing API with fallback handling. Added SOAP endpoint for order import. Designed deterministic test suite with mocked external services.",
    decisions: "Symfony chosen for structured architecture and Doctrine ORM integration. Docker Compose for environment parity. Manticore Search for full-text capabilities beyond MySQL. Mocked external services in tests for determinism. Configurable upstream URL and timeout for price endpoint with controlled fallback responses.",
    stack: ["PHP", "Symfony", "MySQL", "Docker", "Manticore"],
    result: "Fully containerized backend system with test suite. External API integration with graceful fallback. Full-text search via Manticore. Database schema improvements documented for reference. Production-ready architecture with configurable deployment.",
    link: { label: "View on GitHub", url: "https://github.com/Vimpil/order-management-api-symfony" },
  },
  {
    id: "privacy-gateway",
    number: "07",
    title: "Privacy AI Gateway",
    type: "Security-focused backend architecture",
    challenge: "Needed a privacy-first AI gateway with client-side encryption, local inference, and tamper-evident audit logs. Required zero-trust prompt handling where server never receives plaintext, local LLM execution capability, and verifiable audit trail for all interactions.",
    work: "Built FastAPI backend with AES-GCM encryption, PBKDF2 key derivation, and SHA-256 hash chain audit logging. Implemented client-side encryption using Web Crypto API. Integrated Ollama for local LLM inference with Wikipedia enrichment. Designed Oracle transformation layer for response formatting. Built audit log verification system.",
    decisions: "Client-side encryption ensures server never sees plaintext. AES-GCM chosen for authenticated encryption. PBKDF2 with 100k+ iterations for key derivation. SHA-256 hash chain for tamper-evident audit logs. Local-first AI execution via Ollama for privacy. Stateless Oracle layer for presentation without semantic modification.",
    stack: ["Python", "FastAPI", "Cryptography", "React", "TypeScript"],
    result: "Zero-trust AI gateway with end-to-end encryption. Local inference capability. Tamper-evident audit trail. Minimal external dependencies. Security-by-design architecture with encryption, validation, and isolation at every layer.",
    link: { label: "View on GitHub", url: "https://github.com/Vimpil/privacy-ai-gateway" },
  },
  {
    id: "wallet",
    number: "08",
    title: "Ethereum Wallet Dashboard",
    type: "Web3 frontend application",
    challenge: "Needed a modern Ethereum wallet management application with live balance, transaction history, and network status. Required integration with Ethereum wallets, Etherscan API, and real-time price data. Needed robust error handling and validation.",
    work: "Built React + TypeScript application with Vite bundler and Bun runtime. Integrated Wagmi for wallet connection, Etherscan V2 API for transaction history, and React Query for data fetching. Implemented Zod validation for strict data validation. Added ErrorBoundary for UI protection. Designed modular architecture with hooks, components, services, configs, and types.",
    decisions: "React + TypeScript for type safety and component architecture. Vite for fast builds. Bun for package management. React Query for caching and data fetching. Zod for runtime validation. Wagmi for Ethereum wallet integration. Etherscan V2 with chainid-based routing for multi-network support.",
    stack: ["React", "TypeScript", "Vite", "Tailwind CSS", "React Query"],
    result: "Modern wallet dashboard with instant connection, live balance, transaction history, and network status. Light/dark theme toggle. Robust validation and error handling. High performance with optimized requests and caching. Open source under MIT license.",
    link: { label: "View on GitHub", url: "https://github.com/Vimpil/eth-wallet-dashboard" },
  },
  {
    id: "whatsapp-crypto",
    number: "09",
    title: "PHP Media Encryption Library",
    type: "Open-source cryptographic library",
    challenge: "Needed a PHP library for encrypting and decrypting media files using WhatsApp algorithms. Required PSR-7 compatible stream decorators for processing large files without loading entire content into memory. Needed support for various media types with sidecar generation for video and audio streaming.",
    work: "Built PSR-7 stream decorators for encryption and decryption. Implemented HKDF key derivation with SHA-256. Designed StreamFactory with modular validation methods. Added sidecar generation for video and audio streaming. Created comprehensive test suite with 100% coverage. Published to Packagist.",
    decisions: "PSR-7 compatibility for integration with Guzzle HTTP ecosystem. Stream decorators for memory-efficient processing of large files. HKDF for secure key expansion. Separate encryption/decryption streams for clear separation of concerns. Sidecar generation on-the-fly without additional reads from source stream.",
    stack: ["PHP", "OpenSSL", "PSR-7", "Guzzle"],
    result: "Published PHP package on Packagist with 117+ installs. PSR-7 compatible stream decorators. Support for images, video, audio, and documents. Streaming processing for large files. 100% test coverage. MIT licensed.",
    link: { label: "View on Packagist", url: "https://packagist.org/packages/vimpil/whatsapp-media-crypto" },
  },
];

const { sectionId = "work", heading = "Selected Work", subheading = "Production backend systems — solved under real constraints.", studies = defaults } = Astro.props;
---

<section
  id={sectionId}
  class="section-container section-padding relative py-28 sm:py-36 lg:py-44 bg-gradient-section"
  data-reveal
>
  <div class="mx-auto max-w-6xl">
    <div class="section-label">
      <span class="section-label-line" aria-hidden="true" />
      <span class="section-label-text">
        {heading}
      </span>
    </div>

    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="heading-lg text-balance text-zinc-900 dark:text-zinc-100">
        Engineering
        <br />
        <span class="gradient-text">case studies.</span>
      </h2>
      <p class="max-w-md text-base leading-relaxed text-zinc-500 dark:text-zinc-200 sm:text-right">
        {subheading}
      </p>
    </div>

    <div class="mt-12 space-y-4" data-reveal-stagger>
      {
        studies.map((study) => (
          <div
            class="group rounded-2xl border border-zinc-200/60 bg-white transition-all duration-300 hover:border-zinc-300/80 hover:bg-zinc-50/50 dark:border-zinc-800/40 dark:bg-zinc-900/30 dark:hover:border-zinc-700/50 dark:hover:bg-zinc-900/50"
            data-reveal
          >
            <button
              class="case-study-toggle flex w-full items-center gap-4 p-6 text-left sm:gap-6 sm:p-7"
              aria-expanded="false"
              data-target={study.id}
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-zinc-300/60 bg-zinc-100/80 font-heading text-base font-bold text-blue-600 dark:border-zinc-700/60 dark:bg-zinc-800/80 dark:text-blue-400">
                {study.number}
              </span>
              <div class="flex-1 min-w-0">
                <h3 class="heading text-zinc-900 dark:text-zinc-100">{study.title}</h3>
                <p class="mt-1 text-base leading-relaxed text-zinc-500 line-clamp-1 dark:text-zinc-200">
                  {study.type}
                </p>
              </div>
              <svg
                class="case-study-chevron h-5 w-5 shrink-0 text-zinc-400 transition-transform duration-300 dark:text-zinc-200"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </button>

            <div class="case-study-content hidden px-6 pb-7 sm:px-7 sm:pb-8">
              <div class="space-y-6 border-t border-zinc-200/60 pt-6 dark:border-zinc-800/40">
                <div>
                  <h4 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">Challenge</h4>
                  <p class="mt-2 text-base leading-relaxed text-zinc-600 dark:text-zinc-200">{study.challenge}</p>
                </div>

                <div>
                  <h4 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">Engineering Work</h4>
                  <p class="mt-2 text-base leading-relaxed text-zinc-600 dark:text-zinc-200">{study.work}</p>
                </div>

                <div>
                  <h4 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">Technical Decisions</h4>
                  <p class="mt-2 text-base leading-relaxed text-zinc-600 dark:text-zinc-200">{study.decisions}</p>
                </div>

                <div>
                  <h4 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">Result</h4>
                  <p class="mt-2 text-base leading-relaxed text-zinc-600 dark:text-zinc-200">{study.result}</p>
                </div>

                <div class="flex flex-wrap items-center gap-3 pt-2">
                  {study.stack.map((tag) => (
                    <span class="rounded-md border border-zinc-300/60 bg-zinc-100/80 px-2 py-0.5 text-base font-medium text-zinc-600 dark:border-zinc-700/60 dark:bg-zinc-800/80 dark:text-zinc-200">
                      {tag}
                    </span>
                  ))}
                  {study.link && (
                    <a
                      href={study.link.url}
                      target={study.link.url.startsWith("http") ? "_blank" : undefined}
                      rel={study.link.url.startsWith("http") ? "noopener noreferrer" : undefined}
                      class="ml-auto text-base text-blue-600 transition-colors hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300"
                    >
                      {study.link.label} <span aria-hidden="true">&rarr;</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  (() => {
    const toggles = document.querySelectorAll(".case-study-toggle");

    toggles.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-target");
        const card = btn.closest("[data-reveal]");
        if (!card || !target) return;

        const content = card.querySelector(".case-study-content");
        const chevron = btn.querySelector(".case-study-chevron");
        const isOpen = btn.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          content.classList.add("hidden");
          chevron.style.transform = "";
          btn.setAttribute("aria-expanded", "false");
        } else {
          content.classList.remove("hidden");
          chevron.style.transform = "rotate(180deg)";
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });
  })();
</script>
